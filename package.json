{
  "name": "pi-inspect-context",
  "version": "0.1.0",
  "description": "A bounded, read-only Pi extension for locating relevant repository context.",
  "type": "module",
  "keywords": ["pi-package"],
  "files": [
    "extensions/index.ts",
    "src/packet.ts",
    "src/adapter.ts",
    "scripts/build-worker.mjs",
    "worker/go.mod",
    "worker/contract.go",
    "worker/worker.go",
    "worker/cmd/inspect-context/main.go"
  ],
  "pi": {
    "extensions": ["./extensions/index.ts"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "os": ["darwin", "linux"],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "1.3.27"
  },
  "scripts": {
    "build": "node scripts/build-worker.mjs",
    "postinstall": "node scripts/build-worker.mjs",
    "test": "npm run test:node && npm run test:go",
    "test:node": "node --experimental-strip-types --test test/packet.test.ts test/adapter.test.ts test/tool.test.ts",
    "test:go": "cd worker && go test ./..."
  }
}
